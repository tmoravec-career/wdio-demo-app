{
  "name": "wdio-demo-app-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "wdio run ./wdio.conf.ts",
    "test:ios": "PLATFORM=ios wdio run ./wdio.conf.ts",
    "test:android": "PLATFORM=android wdio run ./wdio.conf.ts",
    "test:smoke": "wdio run ./wdio.conf.ts --suite smoke",
    "test:lifecycle": "wdio run ./wdio.conf.ts --suite lifecycle",
    "test:sleep": "wdio run ./wdio.conf.ts --suite sleep",
    "app:fetch": "tsx scripts/app-bundle.ts fetch",
    "app:info": "tsx scripts/app-bundle.ts info",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@wdio/cli": "10.1.0",
    "@wdio/junit-reporter": "10.1.0",
    "@wdio/local-runner": "10.1.0",
    "@wdio/mocha-framework": "10.1.0",
    "@wdio/spec-reporter": "10.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "webdriverio": "10.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
